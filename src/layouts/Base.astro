---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import TopoSymbols from '../components/TopoSymbols.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Browser chrome follows the OS until a theme is chosen; then main.ts and the
         script below point both at the chosen colour (data-color keeps the originals). -->
    <meta name="theme-color" content="#F3F5EF" data-color="#F3F5EF" data-scheme="light" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1811" data-color="#0E1811" data-scheme="dark" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Runs before first paint. With no saved choice there's no data-theme at all and
      // the CSS follows prefers-color-scheme; a saved choice is applied here, so it never flashes.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let saved;
        try { saved = localStorage.getItem('portfolio-theme'); } catch {}
        if (saved !== 'light' && saved !== 'dark') return;
        root.dataset.theme = saved;
        const color = document.querySelector(`meta[name="theme-color"][data-scheme="${saved}"]`).dataset.color;
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = color;
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[100] -translate-y-[200%] rounded-md bg-btn-bg px-4 py-2 font-medium text-btn-fg shadow-lg transition-transform focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-ember"
    >
      Skip to content
    </a>
    <TopoSymbols />
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
