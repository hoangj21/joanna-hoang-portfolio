---
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/order';
import { inline } from '../lib/inline';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Logo from './ui/Logo.astro';
import Facts from './ui/Facts.astro';
import Tags from './ui/Tags.astro';

interface Props {
  num: string;
  header: { label: string; title: string; intro?: string };
}
const { header, num } = Astro.props;
const roles = (await getCollection('experience')).sort(byOrder);
---

<Section id="experience" numeral={num} tone="alt" topo="topo-tall">
  <SectionHeader {...header} num={num} />
  <ol class="trail list-none p-0">
    {
      roles.map(({ data: r }, i) => (
        <li class:list={['grid gap-2.5 py-8 pl-[30px] min-[701px]:grid-cols-[170px_1fr] min-[701px]:gap-x-10 min-[701px]:gap-y-0 min-[701px]:pl-0', i > 0 && 'border-t border-border']}>
          <div class="flex items-center gap-4 pt-1 min-[701px]:flex-col min-[701px]:items-start min-[701px]:gap-3.5">
            <span class="font-mono text-[0.8rem] tabular-nums text-fg-muted">{r.dates}</span>
            <span class="text-fg-faint"><Logo name={r.logo} size="sm" /></span>
          </div>
          <div class:list={['waypoint relative min-w-0', r.current && 'now']}>
            <h3 class="mb-1 font-display text-[1.45rem] font-medium tracking-[-0.01em]">
              {r.role}
              {r.current && (
                <span class="ml-2 inline-block rounded-full border border-ember px-2 py-px align-middle font-mono text-[0.66rem] font-normal uppercase tracking-[0.08em] text-ember-text">
                  Now
                </span>
              )}
            </h3>
            <p class="mb-3 text-[0.95rem] font-semibold text-pine">
              {r.org}
              {r.orgNote && <span class="font-normal text-fg-faint"> · {r.orgNote}</span>}
            </p>
            <p class="m-0 max-w-[64ch] text-[0.97rem] text-fg-muted" set:html={inline(r.description)}></p>
            <Facts facts={r.facts} />
            <Tags tags={r.tags} />
          </div>
        </li>
      ))
    }
  </ol>
</Section>
