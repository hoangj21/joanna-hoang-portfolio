---
interface Props {
  name: string;
}
const { name } = Astro.props;
const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Case studies' },
  { href: '#live', label: 'Live work' },
  { href: '#research', label: 'Research' },
  { href: '#contact', label: 'Contact' },
];
---

<nav
  class="sticky top-[env(safe-area-inset-top,0px)] z-50 border-b border-border bg-bg/85 backdrop-blur-md"
  aria-label="Primary"
>
  <div class="mx-auto flex max-w-[1100px] items-center gap-4 px-[18px] py-3.5 sm:gap-6 sm:px-6">
    <a href="#top" class="whitespace-nowrap font-display text-[1.15rem] font-medium text-fg hover:no-underline">{name}</a>
    <ul
      class="ml-auto flex min-w-0 list-none gap-4 overflow-x-auto p-0 pr-6 text-[0.82rem] font-medium [mask-image:linear-gradient(to_right,#000_80%,transparent)] [scrollbar-width:none] sm:gap-[1.4rem] sm:pr-0 sm:text-[0.88rem] md:[mask-image:none]"
    >
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-nav-link class="whitespace-nowrap text-fg-muted hover:text-ember-text hover:no-underline">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- Shown by main.ts. The icon is the theme a click switches to (CSS picks it, so it
         never flashes); "Auto" appears once a theme is chosen and hands control back to the OS. -->
    <div class="theme-switch" data-theme-switch hidden>
      <button type="button" class="theme-reset" data-theme-reset hidden aria-label="Follow the system theme" title="Follow the system theme">Auto</button>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1Z" /></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
      </button>
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
</nav>
