---
/**
 * Dusk scene over Mt. Hood. The colors here are fixed rather than themed: it's the same
 * evening in light and dark mode. Below the `hero` breakpoint the mountain sits under
 * the text; on wide screens it rises behind it.
 */
import type { CollectionEntry } from 'astro:content';
import { terrain } from '../lib/terrain';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

interface Props {
  site: CollectionEntry<'site'>['data'];
}
const { site } = Astro.props;
const [first, ...rest] = site.name.split(' ');
const h = terrain.hero;
---

<header
  id="top"
  class="relative flex flex-col overflow-hidden bg-[linear-gradient(180deg,#0A1A12_0%,#12291D_38%,#2C4E42_72%,#6F7A5F_100%)] text-cream hero:min-h-[clamp(720px,94vh,920px)]"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_46%_30%_at_72%_78%,rgba(232,150,92,0.5),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-3 mx-auto w-full max-w-[1100px] px-[18px] pt-[clamp(4rem,10vh,7rem)] sm:px-6">
    <p class="mb-7 flex max-w-none flex-wrap gap-x-5 gap-y-1.5 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-cream/55">
      {site.collar.map((c) => <span>{c}</span>)}
    </p>
    <h1 class="mb-5 text-[clamp(3.4rem,10vw,7.2rem)] font-light leading-[0.95] tracking-[-0.045em] text-cream-bright">
      {first}<br /><em class="font-light text-peach-soft">{rest.join(' ')}</em>
    </h1>
    <p class="mb-5 font-mono text-[clamp(0.78rem,1.6vw,0.88rem)] uppercase tracking-[0.08em] text-peach">{site.role}</p>
    <p class="mb-8 max-w-[46ch] text-[clamp(1.05rem,1.9vw,1.2rem)] leading-[1.6] text-cream/85">{site.heroIntro}</p>
    <div class="flex flex-wrap gap-3">
      <Button variant="hero" href={`mailto:${site.email}`}>
        <Icon name="mail" class="size-4 shrink-0" />
        <span class="font-mono text-[0.86rem] font-medium">{site.email}</span>
      </Button>
      <Button variant="hero-ghost" href={site.linkedin} external>
        <Icon name="linkedin" class="size-4 shrink-0" />
        LinkedIn
      </Button>
      {
        site.resumeUrl && (
          <Button variant="hero-ghost" href={site.resumeUrl} external>
            <Icon name="file" class="size-4 shrink-0" />
            Résumé
          </Button>
        )
      }
    </div>
  </div>

  <svg
    class="relative -mt-6 block h-[clamp(280px,40vw,420px)] w-full shrink-0 hero:absolute hero:inset-x-0 hero:bottom-0 hero:mt-0 hero:h-[64%]"
    viewBox={`0 0 ${h.W} ${h.H}`}
    preserveAspectRatio="xMaxYMax slice"
    aria-hidden="true"
  >
    <defs><clipPath id="hood-clip"><path d={h.hood} /></clipPath></defs>
    <path d={h.hood} fill="#5B7A72" />
    <g clip-path="url(#hood-clip)">
      <path d={h.snow} fill="#EEE9DF" />
      <path d={h.ribs} fill="#4E6B66" opacity="0.7" />
      <path d={h.shadow} fill="rgba(16,36,44,.34)" />
    </g>
    <path d={h.r1} fill="#3A5A4D" />
    <path d={h.r2} fill="#2B4A3D" />
    <path d={h.r3} fill="#1F3A2E" />
    <path d={h.trees_far} fill="#1F3A2E" />
    <path d={h.ground} fill="#12271C" />
    <path d={h.trees_near} fill="#12271C" />
  </svg>

  <p class="absolute bottom-32 right-6 z-2 hidden text-right font-mono text-[0.68rem] uppercase tracking-[0.1em] text-cream/50 hero:block">
    {site.heroTag.map((t, i) => (i === 0 ? t : <><br />{t}</>))}
  </p>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-2 h-[70px] bg-linear-to-b from-transparent to-bg hero:h-20" aria-hidden="true">
  </div>
</header>
