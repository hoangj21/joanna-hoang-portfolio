---
import type { TopoId } from '../../lib/terrain';

interface Props {
  id: TopoId;
  tone?: 'default' | 'band';
  flip?: boolean;
}
const { id, tone = 'default', flip = false } = Astro.props;
---

<svg
  class:list={[
    'pointer-events-none absolute inset-0 z-0 h-full w-full',
    tone === 'band' ? 'text-[var(--band-topo-index)]' : 'text-[var(--topo-index)]',
    flip && '-scale-x-100',
  ]}
  aria-hidden="true"
>
  <use href={`#${id}`} width="100%" height="100%"></use>
</svg>
