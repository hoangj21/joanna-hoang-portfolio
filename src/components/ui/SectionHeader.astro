---
import Label from './Label.astro';

interface Props {
  label: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'band';
}
const { label, title, intro, tone = 'default' } = Astro.props;
---

<Label text={label} tone={tone} />
<h2 class="mb-4 text-[clamp(2.2rem,5vw,3.4rem)] tracking-[-0.025em]">{title}</h2>
{
  intro && (
    <p class:list={['mb-10 max-w-[58ch] text-[1.05rem]', tone === 'band' ? 'text-band-muted' : 'text-fg-muted']}>
      {intro}
    </p>
  )
}
