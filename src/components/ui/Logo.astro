---
import { logos, type LogoKey } from '../../lib/logos';

interface Props {
  name: LogoKey;
  size?: 'lg' | 'sm';
}
const { name, size = 'lg' } = Astro.props;
const logo = logos[name];
---

<span
  class:list={['flex items-center', size === 'lg' ? 'h-6 sm:h-[30px]' : 'h-[22px]']}
  title={logo.label}
>
  {
    logo.kind === 'svg' ? (
      <svg viewBox={logo.viewBox} class="block h-full w-auto fill-current" role="img" aria-label={logo.label}>
        <path d={logo.path} />
      </svg>
    ) : (
      <span
        class:list={[
          'leading-none',
          size === 'lg' ? 'text-[1.25rem]' : 'text-base',
          logo.style === 'serif' ? 'font-display font-medium' : 'font-body font-bold tracking-[-0.02em]',
        ]}
        aria-label={logo.label}
      >
        {logo.text}
      </span>
    )
  }
</span>
