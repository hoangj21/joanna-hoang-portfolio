---
/** Small inline icons used by buttons and cards. */
interface Props {
  name: 'mail' | 'linkedin' | 'file' | 'chevron' | 'pylon' | 'fluke' | 'helix';
  class?: string;
}
const { name, class: className } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

{name === 'mail' && (
  <svg viewBox="0 0 24 24" class={className} {...stroke} stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 7l-10 7L2 7" /></svg>
)}
{name === 'linkedin' && (
  <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
)}
{name === 'file' && (
  <svg viewBox="0 0 24 24" class={className} {...stroke} stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3" /></svg>
)}
{name === 'chevron' && (
  <svg viewBox="0 0 24 24" class={className} {...stroke} stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
)}
{name === 'pylon' && (
  <svg viewBox="0 0 40 40" class={className} {...stroke} stroke-width="1.5" aria-hidden="true"><path d="M20 3 L13 37 M20 3 L27 37 M8 11 H32 M10 19 H30 M15 27 h10 M14 11 l12 8 M26 11 l-12 8" /></svg>
)}
{name === 'fluke' && (
  <svg viewBox="0 0 40 40" class={className} {...stroke} stroke-width="1.5" aria-hidden="true"><path d="M20 36 C19 28 19 22 20 16 C14 16 6 12 4 5 C10 8 15 8 20 11 C25 8 30 8 36 5 C34 12 26 16 20 16" /></svg>
)}
{name === 'helix' && (
  <svg viewBox="0 0 40 40" class={className} {...stroke} stroke-width="1.5" aria-hidden="true"><path d="M13 3 C13 13 27 13 27 20 C27 27 13 27 13 37 M27 3 C27 13 13 13 13 20 C13 27 27 27 27 37 M15 8 H25 M15 32 H25 M17 15 H23 M17 25 H23" /></svg>
)}
