---
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/order';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import CaseStudy from './cases/CaseStudy.astro';

interface Props {
  num: string;
  header: { label: string; title: string; intro?: string };
}
const { header, num } = Astro.props;
const cases = (await getCollection('cases')).sort(byOrder);
---

<Section id="work" numeral={num}>
  <SectionHeader {...header} num={num} />
  <div class="grid grid-cols-1 items-start gap-4 min-[701px]:grid-cols-2" data-stagger>
    {cases.map((entry, index) => <CaseStudy entry={entry} index={index} />)}
  </div>
</Section>
