---
import type { CollectionEntry } from 'astro:content';

interface Props { data: CollectionEntry<'cases'>['data']; }
const { data: c } = Astro.props;
---

<!-- Reuse the field-notes cover pattern and existing project artifacts only. -->
<div class="case-cover">
  {c.image?.src ? (
    <img src={c.image.src} alt={c.image.alt ?? ''} loading="lazy" />
  ) : c.diagram ? (
    <ol class="cover-diagram" role="list" aria-label="Workflow preview">
      {c.diagram.steps.map((step, i) => (
        <li class:list={['cover-step', step.mine && 'cover-step-owned']}>
          <small>{String(i + 1).padStart(2, '0')}</small>{step.label}
          {step.mine && <span class="sr-only"> (my part)</span>}
        </li>
      ))}
    </ol>
  ) : null}
</div>

<style>
  .case-cover { border-bottom: 1px solid var(--border); background: var(--bg-alt); }
  img { display: block; width: 100%; height: 260px; object-fit: contain; }
  .cover-diagram {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-content: center; gap: 12px; min-height: 260px; padding: 20px;
    margin: 0; list-style: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .cover-step {
    display: flex; align-items: baseline; gap: 8px; min-width: 0; padding: 10px;
    border: 1px solid var(--border-strong); border-radius: 2px;
    background: var(--card); color: var(--fg); font-size: .74rem;
    line-height: 1.4; overflow-wrap: anywhere;
  }
  small { flex-shrink: 0; white-space: nowrap; font: .6rem var(--font-mono); color: var(--fg-muted); }
  .cover-step-owned {
    border: 1.5px solid var(--ember);
    background: color-mix(in srgb, var(--ember) 12%, var(--card));
    box-shadow: inset 3px 0 var(--ember);
  }
  /* Keep the small ember numbers above 4.5:1 on the tinted light surface. */
  .cover-step-owned small { color: color-mix(in srgb, var(--ember-text) 98%, var(--fg)); }
</style>
