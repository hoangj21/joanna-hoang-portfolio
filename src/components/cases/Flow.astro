---
/**
 * Architecture flow with the steps Joanna owned highlighted. Wraps on wide screens, stacks on phones.
 * `--i` and `--n` drive the left-to-right play-in when the case opens (see `.flow` in global.css).
 */
interface Props {
  steps: { label: string; mine: boolean }[];
  note?: string;
}
const { steps, note } = Astro.props;
---

<figure class="col-span-full m-0 min-w-0 rounded-md border border-border bg-bg-alt px-5 pb-4 pt-[1.1rem]">
  <p class="mb-3 flex max-w-none items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-fg-faint">
    <span class="h-2.5 w-3.5 rounded-[2px] border-[1.5px] border-ember bg-ember/15" aria-hidden="true"></span>
    My part
  </p>
  <ol
    class="flow m-0 flex list-none flex-col items-start gap-[1.35rem] p-0 min-[601px]:flex-row min-[601px]:flex-wrap min-[601px]:items-center min-[601px]:gap-x-0 min-[601px]:gap-y-[0.55rem]"
    style={`--n: ${steps.length}`}
  >
    {
      steps.map((s, i) => (
        <li
          class:list={[
            'flex items-center rounded px-[0.7rem] py-[0.45rem] text-[0.84rem] leading-[1.3] text-fg',
            s.mine ? 'mine' : 'border border-border-strong bg-card',
          ]}
          style={`--i: ${i}`}
        >
          {s.label}
          {s.mine && <span class="sr-only"> (my part)</span>}
        </li>
      ))
    }
  </ol>
  {note && <figcaption class="mt-3 text-[0.82rem] text-fg-muted">{note}</figcaption>}
</figure>
