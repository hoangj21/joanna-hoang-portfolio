---
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/order';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Facts from './ui/Facts.astro';
import Tags from './ui/Tags.astro';
import Icon from './ui/Icon.astro';
import Ridge from './Ridge.astro';

interface Props {
  header: { label: string; title: string; intro?: string };
}
const { header } = Astro.props;
const entries = (await getCollection('research')).sort(byOrder);
---

<Ridge into />
<Section id="research" numeral="05" tone="band" topo="topo-c">
  <SectionHeader {...header} tone="band" />
  <div class="grid gap-6 min-[900px]:grid-cols-3" data-stagger>
    {
      entries.map(({ data: e }, i) => (
        <article class="flex flex-col gap-3 rounded-[10px] border border-band-border bg-band-card p-[1.6rem]" style={`--i: ${i}`}>
          <div class="flex items-start justify-between gap-4">
            <p class="m-0 font-mono text-[0.7rem] uppercase leading-relaxed tracking-[0.07em] text-band-muted">
              {e.note}
              <br />
              {e.dates} · {e.org}
            </p>
            <Icon name={e.icon} class="size-10 shrink-0 text-peach-deep" />
          </div>
          <h3 class="m-0 text-[1.35rem] font-medium text-band-fg">{e.title}</h3>
          {e.figure && (
            <figure class="m-0 rounded-md bg-white px-2 pb-1.5 pt-2">
              <img src={e.figure.src} alt={e.figure.alt} width={e.figure.width} height={e.figure.height} loading="lazy" class="block h-auto w-full max-w-full rounded-[3px]" />
              <figcaption class="mt-1.5 font-mono text-[0.66rem] tracking-[0.03em] text-[#4D604E]">{e.figure.caption}</figcaption>
            </figure>
          )}
          <p class="m-0 text-[0.93rem] text-band-muted">{e.body}</p>
          <Facts facts={e.facts} tone="band" />
          <Tags tags={e.tags} tone="band" class="mt-1" />
          {e.link && (
            <a href={e.link.href} target="_blank" rel="noopener" class="mt-auto pt-1.5 text-[0.9rem] font-semibold text-peach hover:text-[#F6D2B2]">
              {e.link.label}
            </a>
          )}
        </article>
      ))
    }
  </div>
</Section>
<Ridge into={false} />
